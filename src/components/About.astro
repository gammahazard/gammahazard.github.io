---
import { site } from "../data/site";
---
<section id="about" class="reveal grid scroll-mt-20 gap-10 border-t border-line py-16 md:grid-cols-[1fr_1fr]">
  <div>
    <h2 class="flex items-center gap-3 font-mono text-sm uppercase tracking-[0.2em] text-ink">
      <span class="h-px w-8 bg-accent"></span>About
    </h2>
    <div class="mt-6 space-y-4 text-[14px] leading-relaxed text-muted">
      {site.bio.map((p) => <p>{p}</p>)}
      <p class="text-faint" set:html={site.earlierWork}></p>
    </div>
  </div>
  <div class="md:pt-11">
    <div class="grid gap-6 sm:grid-cols-2">
      {site.skills.map((s) => (
        <div>
          <h3 class="font-mono text-[11px] uppercase tracking-wider text-accent">{s.group}</h3>
          <div class="mt-3 flex flex-wrap gap-1.5">
            {s.items.map((i) => (
              <span class="rounded-full border border-line bg-panel/40 px-2.5 py-1 text-[11.5px] text-muted">{i}</span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
